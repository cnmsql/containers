# check=skip=InvalidDefaultArgInFrom
# (The base image has no default on purpose: docker-bake.hcl pins it by digest.)
# Our own slim Percona Server instance image.
#
# Instead of layering onto the fat upstream `percona/percona-server` image, we
# build from a minimal Debian base and install only what the instance manager
# needs at runtime: the Percona Server `mysqld` (plus its init tooling),
# XtraBackup, and the few client tools the manager executes (`mysql`,
# `mysqlbinlog`, `mysqldump`). The `manager` binary itself is copied in by the
# operator at Pod start. Everything else — the other mysql client utilities,
# docs, man pages, the mysql-test suite, debug builds — is stripped. The tools
# the manager relies on are listed in images/required-tools.txt and checked
# after every build.
#
# The image is parameterized by build args so a single Dockerfile covers every
# supported version. The args, including the exact package versions, come from
# docker-bake.hcl; build through bake rather than by hand:
#
#   docker buildx bake mysql-8-4-bookworm --load
#
# Package sources are verified against the Percona signing keyring committed in
# keys/percona-keyring.gpg: nothing is downloaded and trusted at build time.
#
# The image runs as an unprivileged user (uid 1001); mysqld and the manager
# never need root, and every port they bind is above 1024.
#
# Two runtime targets share the same pinned packages:
#
#   debian      the packages installed on the Debian base (tags *-bookworm);
#   distroless  the same files, minus the package manager, shell and every
#               other tool the server does not load, on a distroless base
#               (tags *-distroless). See build/distroless-rootfs.sh.

ARG BASE_IMAGE
ARG DISTROLESS_IMAGE

FROM ${DISTROLESS_IMAGE} AS distroless-base

FROM ${BASE_IMAGE} AS debian

# Re-declare the args needed in this stage (ARGs do not cross FROM boundaries).
# PS_VERSION and PXB_VERSION are exact Debian package versions, e.g.
# 8.4.11-11-1.bookworm. PERCONA_COMPONENT is the apt component: "main" for GA
# releases, "testing" for pre-GA ones.
ARG PERCONA_COMPONENT=main
ARG PS_REPO
ARG PS_VERSION
ARG PXB_REPO
ARG PXB_PACKAGE
ARG PXB_VERSION

# Fixed, unprivileged identity for the server. Created before package install so
# the percona-server-server postinst reuses it instead of allocating a dynamic
# uid; gid 0 (root group) + group-writable data dirs keep the image usable under
# arbitrary-uid platforms (OpenShift) without granting any real privilege.
ARG MYSQL_UID=1001
ARG MYSQL_GID=1001

COPY keys/percona-keyring.gpg /usr/share/keyrings/percona-keyring.gpg

RUN set -eux; \
    export DEBIAN_FRONTEND=noninteractive; \
    . /etc/os-release; codename="${VERSION_CODENAME}"; \
    groupadd -g "${MYSQL_GID}" mysql; \
    useradd -u "${MYSQL_UID}" -g mysql -s /usr/sbin/nologin -M mysql; \
    # Stop package postinst scripts from trying to start mysqld during build.
    printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d; \
    chmod +x /usr/sbin/policy-rc.d; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates; \
    # The server and XtraBackup repos for this version, plus Percona's telemetry
    # repo: percona-server-server depends on percona-telemetry-agent, which is
    # deleted below. These are the repos percona-release would enable, written
    # directly so the image does not need percona-release or a key download.
    for repo in "${PS_REPO}" "${PXB_REPO}"; do \
        echo "deb [signed-by=/usr/share/keyrings/percona-keyring.gpg] https://repo.percona.com/${repo}/apt ${codename} ${PERCONA_COMPONENT}"; \
    done > /etc/apt/sources.list.d/percona.list; \
    echo "deb [signed-by=/usr/share/keyrings/percona-keyring.gpg] https://repo.percona.com/telemetry/apt ${codename} main" \
        >> /etc/apt/sources.list.d/percona.list; \
    apt-get update; \
    # Exact versions: percona-server-server depends on the matching client and
    # common packages with "=", so pinning it pins the whole server.
    apt-get install -y --no-install-recommends \
        "percona-server-server=${PS_VERSION}" "${PXB_PACKAGE}=${PXB_VERSION}"; \
    # Trim everything the manager does not need at runtime.
    #   - docs/man/locale/test suites: never used in a running instance;
    #   - *-debug binaries and the debug/ plugin variants: duplicate, huge;
    #   - the telemetry agent: phones home and never starts (manager is PID1);
    #   - static (.a) libraries: dev artefacts, not loaded at runtime.
    rm -rf \
        /usr/share/doc /usr/share/doc-base /usr/share/man /usr/share/info \
        /usr/share/lintian /usr/share/locale \
        /usr/lib/mysql-test /usr/share/mysql*/mysql-test \
        /usr/sbin/mysqld-debug /usr/bin/xtrabackup-debug \
        /usr/lib/mysql/plugin/debug \
        /usr/bin/percona-telemetry-agent \
        /etc/cron.d/percona-telemetry-agent \
        /usr/lib/systemd/system/percona-telemetry-agent.service \
        /var/lib/apt/lists/* /var/cache/apt/* \
        /usr/sbin/policy-rc.d; \
    find /usr/lib -name '*.a' -delete; \
    # Drop the bulky mysql client utilities the instance does not need. We keep:
    # mysql + mysqladmin (operator debugging via `kubectl exec`, and liveness
    # ping), mysqlbinlog (binlog streaming / PITR), mysqldump (logical backups),
    # and the XtraBackup suite. mysqlpump stays stripped: it is deprecated in
    # 8.0.34 and gone in 8.4. rm -f tolerates a tool being absent on a version.
    for b in mysqlpump mysqlcheck mysqlshow \
             mysqlimport mysqlslap mysqlanalyze mysqloptimize mysqlrepair \
             mysqldumpslow mysqld_multi mysql_upgrade mysql_secure_installation \
             mysql_migrate_keyring mysql_ssl_rsa_setup mysql_tzinfo_to_sql \
             myisamchk myisampack myisamlog myisam_ftdump comp_err perror replace; do \
        rm -f "/usr/bin/$b"; \
    done; \
    # Ship an empty, mysql-owned data dir and runtime dir; the manager runs
    # initdb/join into the (PVC-backed) data dir at first boot.
    rm -rf /var/lib/mysql; \
    mkdir -p /var/lib/mysql /var/run/mysqld; \
    chown -R "${MYSQL_UID}:0" /var/lib/mysql /var/run/mysqld; \
    chmod -R g=u /var/lib/mysql /var/run/mysqld

USER ${MYSQL_UID}

# Everything the distroless image adds to its base, collected from the Debian
# stage above so both targets carry byte-identical server files.
FROM debian AS distroless-rootfs
USER root
COPY build/distroless-rootfs.sh /usr/local/bin/distroless-rootfs
COPY --from=distroless-base /var/lib/dpkg/status.d /distroless/status.d
COPY --from=distroless-base /etc/passwd /etc/group /rootfs/etc/
ARG MYSQL_UID=1001
ARG MYSQL_GID=1001
# Seed with every Percona package installed above (server, client, XtraBackup;
# 9.7 splits them further into -core and -plugins packages), except the
# telemetry agent, whose binary the Debian stage already deleted.
RUN set -eux; \
    distroless-rootfs /rootfs /distroless/status.d \
        $(dpkg-query -W -f='${db:Status-Status} ${Package}\n' 'percona-*' | \
          awk '$1 == "installed" && $2 != "percona-telemetry-agent" { print $2 }'); \
    echo "mysql:x:${MYSQL_UID}:${MYSQL_GID}:mysql:/nonexistent:/sbin/nologin" >> /rootfs/etc/passwd; \
    echo "mysql:x:${MYSQL_GID}:" >> /rootfs/etc/group; \
    mkdir -p /rootfs/var/lib/mysql /rootfs/var/run/mysqld; \
    chown "${MYSQL_UID}:0" /rootfs/var/lib/mysql /rootfs/var/run/mysqld; \
    chmod 0775 /rootfs/var/lib/mysql /rootfs/var/run/mysqld

FROM distroless-base AS distroless
COPY --from=distroless-rootfs /rootfs /
ARG MYSQL_UID=1001
USER ${MYSQL_UID}

# The Debian image stays the default target for a plain `docker build`.
FROM debian
