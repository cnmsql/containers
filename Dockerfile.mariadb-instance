# check=skip=InvalidDefaultArgInFrom
# (The base image has no default on purpose: docker-bake.hcl pins it by digest.)
# Our own slim MariaDB instance image.
#
# The MariaDB counterpart to Dockerfile.instance (which builds Percona Server).
# Same philosophy: start from a minimal Debian base and install only what the
# instance manager needs at runtime — the MariaDB server (`mariadbd`), its
# backup tool (`mariabackup`, from mariadb-backup), and the handful of client
# binaries used for liveness checks, binlog streaming and logical backups. Docs,
# man pages, locales, the test suite and static libraries are stripped. The
# tools the manager relies on are listed in images/mariadb-required-tools.txt
# and checked after every build.
#
# MariaDB, unlike Percona/MySQL, has no `mysqld --initialize`: a fresh data dir
# is bootstrapped with `mariadb-install-db` (a.k.a. `mysql_install_db`), so we
# deliberately keep that tool in the image.
#
# The image is parameterized by build args so a single Dockerfile covers every
# supported MariaDB series. The args, including the exact package version, come
# from docker-bake.hcl; build through bake rather than by hand:
#
#   docker buildx bake mariadb-11-4-bookworm --load
#
# Package sources are verified against MariaDB's signing keyring committed in
# keys/mariadb-keyring-2025.gpg: nothing is downloaded and trusted at build time.
#
# The runtime stage runs as an unprivileged user (uid 1001); mariadbd and the
# manager never need root, and every port they bind is above 1024.

ARG BASE_IMAGE

FROM ${BASE_IMAGE}

# Re-declare the args needed in this stage (ARGs do not cross FROM boundaries).
# MARIADB_VERSION is the release (e.g. 11.4.13) and selects MariaDB's
# per-release apt repo, which keeps the release installable after newer ones
# ship. MARIADB_PACKAGE_VERSION is its exact package version, e.g.
# 1:11.4.13+maria~deb12.
ARG MARIADB_VERSION
ARG MARIADB_PACKAGE_VERSION

# Fixed, unprivileged identity for the server. Created before package install so
# the mariadb-server postinst reuses it instead of allocating a dynamic uid;
# gid 0 (root group) + group-writable data dirs keep the image usable under
# arbitrary-uid platforms (OpenShift) without granting any real privilege.
ARG MYSQL_UID=1001
ARG MYSQL_GID=1001

COPY keys/mariadb-keyring-2025.gpg /etc/apt/keyrings/mariadb-keyring.gpg

RUN set -eux; \
    export DEBIAN_FRONTEND=noninteractive; \
    . /etc/os-release; codename="${VERSION_CODENAME}"; \
    groupadd -g "${MYSQL_GID}" mysql; \
    useradd -u "${MYSQL_UID}" -g mysql -s /usr/sbin/nologin -M mysql; \
    # Stop package postinst scripts from trying to start mariadbd during build.
    printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d; \
    chmod +x /usr/sbin/policy-rc.d; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates; \
    echo "deb [signed-by=/etc/apt/keyrings/mariadb-keyring.gpg] https://dlm.mariadb.com/repo/mariadb-server/${MARIADB_VERSION}/repo/debian ${codename} main" \
        > /etc/apt/sources.list.d/mariadb.list; \
    # Debian ships its own mariadb-* packages; always take MariaDB's.
    printf 'Package: *\nPin: origin dlm.mariadb.com\nPin-Priority: 1000\n' \
        > /etc/apt/preferences.d/mariadb; \
    apt-get update; \
    # The instance manager drives the server by its MySQL names (`mysqld`,
    # `mysqladmin`, `mysqlbinlog`, `mysql_install_db`) because it is shared with
    # the Percona image. Newer MariaDB series (11.x/12.x) ship those legacy names
    # only in the mariadb-*-compat packages, which --no-install-recommends would
    # otherwise drop; older series (10.x) ship them directly and have no such
    # packages. Install the compat packages only when the enabled repo provides
    # them, so a single Dockerfile covers every series.
    compat=""; \
    for p in mariadb-server-compat mariadb-client-compat; do \
        if apt-cache show "$p" > /dev/null 2>&1; then compat="$compat $p=${MARIADB_PACKAGE_VERSION}"; fi; \
    done; \
    apt-get install -y --no-install-recommends \
        "mariadb-server=${MARIADB_PACKAGE_VERSION}" "mariadb-backup=${MARIADB_PACKAGE_VERSION}" ${compat}; \
    # Trim everything the manager does not need at runtime.
    #   - docs/man/locale: never used in a running instance;
    #   - the mysql/mariadb test suite (kept out by not installing mariadb-test,
    #     but any stray copy under /usr/share is removed too);
    #   - static (.a) libraries: dev artefacts, not loaded at runtime.
    rm -rf \
        /usr/share/doc /usr/share/doc-base /usr/share/man /usr/share/info \
        /usr/share/lintian /usr/share/locale \
        /usr/share/mysql*/mysql-test /usr/share/mysql*/mariadb-test \
        /var/lib/apt/lists/* /var/cache/apt/*; \
    find /usr/lib -name '*.a' -delete; \
    # Drop the bulky client utilities the instance does not need. MariaDB ships
    # each tool as a real `mariadb-*` binary plus a legacy `mysql*` symlink, so
    # we remove both names. We keep: mariadb/mysql + mariadb-admin/mysqladmin
    # (operator debugging via `kubectl exec`, liveness ping), mariadb-binlog/
    # mysqlbinlog (binlog streaming / PITR), mariadb-dump (logical backups),
    # mariabackup (the backup suite), and mariadb-install-db/mysql_install_db
    # (data-dir bootstrap). The mysqldump alias is still removed: the manager
    # calls mariadb-dump, the real binary on every supported series. rm -f
    # tolerates a tool being absent on a given series.
    for b in mysqldump \
             mariadb-import mysqlimport \
             mariadb-show mysqlshow \
             mariadb-slap mysqlslap \
             mariadb-access mysqlaccess \
             mariadb-hotcopy mysqlhotcopy \
             mariadb-convert-table-format mysql_convert_table_format \
             mariadb-find-rows mysql_find_rows \
             mariadb-fix-extensions mysql_fix_extensions \
             mariadb-setpermission mysql_setpermission \
             mariadb-secure-installation mysql_secure_installation \
             mariadb-tzinfo-to-sql mysql_tzinfo_to_sql \
             mariadb-waitpid mysql_waitpid \
             mariadb-dumpslow mysqldumpslow \
             myisamchk myisampack myisamlog myisam_ftdump; do \
        rm -f "/usr/bin/$b"; \
    done; \
    rm -f /usr/sbin/policy-rc.d; \
    # Ship an empty, mysql-owned data dir and runtime dir; the manager runs
    # mariadb-install-db / join into the (PVC-backed) data dir at first boot.
    rm -rf /var/lib/mysql; \
    mkdir -p /var/lib/mysql /var/run/mysqld; \
    chown -R "${MYSQL_UID}:0" /var/lib/mysql /var/run/mysqld; \
    chmod -R g=u /var/lib/mysql /var/run/mysqld

USER ${MYSQL_UID}
